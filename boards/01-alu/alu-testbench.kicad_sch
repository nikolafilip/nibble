	(text "Case  A   B  SUB EO ->  S  CF ZF   (S = 4-bit result; bus lines go low where S has a 1 and EO=1)\n 0   0.00.. 0.40 ms   A= 3 B= 4 ADD EO=1 -> S= 7 CF=0 ZF=0\n 1   0.40.. 0.80 ms   A= 7 B= 5 SUB EO=1 -> S= 2 CF=1 ZF=0\n 2   0.80.. 1.20 ms   A= 6 B= 6 SUB EO=1 -> S= 0 CF=1 ZF=1\n 3   1.20.. 1.60 ms   A= 2 B= 5 SUB EO=1 -> S=13 CF=0 ZF=0\n 4   1.60.. 2.00 ms   A= 9 B= 7 ADD EO=1 -> S= 0 CF=1 ZF=1\n 5   2.00.. 2.40 ms   A=15 B= 1 ADD EO=1 -> S= 0 CF=1 ZF=1\n 6   2.40.. 2.80 ms   A= 0 B= 0 SUB EO=1 -> S= 0 CF=1 ZF=1\n 7   2.80.. 3.20 ms   A= 8 B= 8 ADD EO=1 -> S= 0 CF=1 ZF=1\n 8   3.20.. 3.60 ms   A= 5 B= 3 SUB EO=1 -> S= 2 CF=1 ZF=0\n 9   3.60.. 4.00 ms   A=12 B= 4 SUB EO=1 -> S= 8 CF=1 ZF=0\n10   4.00.. 4.40 ms   A= 1 B=15 ADD EO=1 -> S= 0 CF=1 ZF=1\n11   4.40.. 4.80 ms   A= 7 B= 1 SUB EO=1 -> S= 6 CF=1 ZF=0\n12   4.80.. 5.20 ms   A= 5 B= 3 ADD EO=0 -> S= 8 CF=0 ZF=0\n"
