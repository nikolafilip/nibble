	(text "NIBBLE BOARD 01 - ALU: 4-bit two's-complement adder/subtractor with carry and zero flags"
		(exclude_from_sim no)
		(at 25.4 15.24 0)
		(effects
			(font
				(size 3.5 3.5)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "ecdc957d-de4f-4dd8-8be2-6227c3d9fda6")
	)
	(text "Cell: 2N7000 + 47k pull-up (NMOS, see docs/gate-cell.md).  137 transistors, 78 resistors, 6 LEDs.\nInputs from the bus header: A3..A0, B3..B0 (register contents), SUB (1 = subtract), EO (1 = drive the result onto the bus).\nOutputs: CF (carry out; for SUB, 1 = no borrow), ZF (result is zero), BUS3#..BUS0# (open-drain, active-low: pulled low where the result bit is 1 and EO = 1).\nResult S = A + (B xor SUB) + SUB.  Gates read left to right, top to bottom: input labels on the left of each cell, output label on the right.\nSheet 2 (TESTBENCH) holds the stimulus sources and the hub pull-ups; they are excluded from the board."
		(exclude_from_sim no)
		(at 25.4 40.64 0)
		(effects
			(font
				(size 1.6 1.6)
			)
			(justify left bottom)
		)
		(uuid "53ae879c-17a9-4a43-962f-37a2ebc0e8b3")
	)
