	(text "TESTBENCH for board 02.  Excluded from the board and the BOM.  Run the simulator (Inspect > Simulator) and plot A3..A0, B3..B0, OUT3..OUT0, BUS3#..BUS0#.\nThe clock rises every 1 ms from 2 ms; the control lines and the bus data change 20 us after each rising edge (as the sequencer would)."
		(exclude_from_sim no)
		(at 25.4 15.24 0)
		(effects
			(font
				(size 2.5 2.5)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "20a60be6-b57d-4295-a63b-1e36712d24b3")
	)
