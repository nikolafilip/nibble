	(text "NIBBLE BOARD 05 - CLOCK: RC oscillator with a speed knob, RUN/STEP switch, halt, power-on reset"
		(exclude_from_sim no)
		(at 25.4 15.24 0)
		(effects
			(font
				(size 3.5 3.5)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "c4856893-684f-4a77-9429-09e81814ce7b")
	)
	(text "16 transistors, 20 resistors, 2 LEDs, one pot, one switch, one jumper.\nRUN: the switch puts 10k from +5V on CLK and the oscillator pulls CLK low for half of each cycle, or for as long as HLT is high.\nSTEP: the switch is open and the pull-down transistor is held off; the front panel's CLK button owns the line, one edge per press.\nSpeed: a Schmitt-trigger RC oscillator, 100k + the pot from SA to X, 47n on X: about 500 Hz down to 40 Hz; the SLOW jumper adds 2.2u for 10 Hz down to 0.8 Hz.\nPower-on reset: 2.2 uF charging through 100k into a Schmitt trigger holds RST high for a tenth of a second after power-up, so the machine starts at address 0 without touching the panel."
		(exclude_from_sim no)
		(at 25.4 40.64 0)
		(effects
			(font
				(size 1.6 1.6)
			)
			(justify left bottom)
		)
		(uuid "3c70bb03-14e9-4029-b2fc-dfb350b94d1e")
	)
