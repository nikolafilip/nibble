	(text "NIBBLE CARD CTR0 - COUNTER BIT 0: program counter bit 0 and return register bit 0"
		(exclude_from_sim no)
		(at 25.4 15.24 0)
		(effects
			(font
				(size 3.5 3.5)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "ce02279e-0cd7-4d4a-9d3e-987a329d6463")
	)
	(text "Cell: 2N7000 + 47k pull-up (NMOS, see docs/gate-cell.md).  62 transistors, 34 resistors, 2 LEDs, 100 x 100 mm (docs/cards.md).\nFrom the bus header: PCE (count), PCL (load the jump target), CLK, RST.   To the bus header: PC0.\nFrom the sequencer over the LINK ribbon (2x6, chained along the eight counter cards): OPR0 (the jump target bit), PCR (load the return address), RAI (save the return address).\nBit 0 counts on PCE itself; TC1 = TC0 and PC0 out to bit 1 over the OUT link.\nPC0: a master-slave flip-flop whose input is PC xor carry (count, or hold when PCE is low), OPR0 (PCL) or RA0 (PCR).  RA0: a transparent latch open while RAI and PH1.  RST clears both.\ndocs/isa.md is the specification; sim/emu.py the reference the whole-machine simulation checks the cards against."
		(exclude_from_sim no)
		(at 25.4 45.72 0)
		(effects
			(font
				(size 1.6 1.6)
			)
			(justify left bottom)
		)
		(uuid "89a1bcf8-6eda-475b-bcf5-4935ef2ada81")
	)
	(text "TWO-PHASE CLOCK and RSTN (as on the register and sequencer boards)"
		(exclude_from_sim no)
		(at 25.4 165.1 0)
		(effects
			(font
				(size 2 2)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "68cb6d27-0a78-45e9-a8f7-d37c435beb48")
	)
