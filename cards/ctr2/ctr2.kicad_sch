	(text "NIBBLE CARD CTR2 - COUNTER BIT 2: program counter bit 2 and return register bit 2"
		(exclude_from_sim no)
		(at 25.4 15.24 0)
		(effects
			(font
				(size 3.5 3.5)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "1f1a327d-1207-41a1-a022-def60031a051")
	)
	(text "Cell: 2N7000 + 47k pull-up (NMOS, see docs/gate-cell.md).  62 transistors, 34 resistors, 2 LEDs, 100 x 100 mm (docs/cards.md).\nFrom the bus header: PCE (count), PCL (load the jump target), CLK, RST.   To the bus header: PC2.\nFrom the sequencer over the LINK ribbon (2x6, chained along the eight counter cards): OPR2 (the jump target bit), PCR (load the return address), RAI (save the return address).\nCount carry TC2 in from bit 1 over the IN link; TC3 = TC2 and PC2 out to bit 3 over the OUT link.\nPC2: a master-slave flip-flop whose input is PC xor carry (count, or hold when PCE is low), OPR2 (PCL) or RA2 (PCR).  RA2: a transparent latch open while RAI and PH1.  RST clears both.\ndocs/isa.md is the specification; sim/emu.py the reference the whole-machine simulation checks the cards against."
		(exclude_from_sim no)
		(at 25.4 45.72 0)
		(effects
			(font
				(size 1.6 1.6)
			)
			(justify left bottom)
		)
		(uuid "c3561a57-2e3d-4d20-a2a9-781bf06f7be9")
	)
	(text "TWO-PHASE CLOCK and RSTN (as on the register and sequencer boards)"
		(exclude_from_sim no)
		(at 25.4 165.1 0)
		(effects
			(font
				(size 2 2)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "bc0988d7-59e3-4bb8-a8c8-203a107a6625")
	)
