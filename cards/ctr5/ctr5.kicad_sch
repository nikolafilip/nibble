	(text "NIBBLE CARD CTR5 - COUNTER BIT 5: program counter bit 5 and return register bit 5"
		(exclude_from_sim no)
		(at 25.4 15.24 0)
		(effects
			(font
				(size 3.5 3.5)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "b9aea6ba-b2f0-492b-aa6f-6ca46a9e6788")
	)
	(text "Cell: 2N7000 + 47k pull-up (NMOS, see docs/gate-cell.md).  62 transistors, 34 resistors, 2 LEDs, 100 x 100 mm (docs/cards.md).\nFrom the bus header: PCE (count), PCL (load the jump target), CLK, RST.   To the bus header: PC5.\nFrom the sequencer over the LINK ribbon (2x6, chained along the eight counter cards): OPR5 (the jump target bit), PCR (load the return address), RAI (save the return address).\nCount carry TC5 in from bit 4 over the IN link; TC6 = TC5 and PC5 out to bit 6 over the OUT link.\nPC5: a master-slave flip-flop whose input is PC xor carry (count, or hold when PCE is low), OPR5 (PCL) or RA5 (PCR).  RA5: a transparent latch open while RAI and PH1.  RST clears both.\ndocs/isa.md is the specification; sim/emu.py the reference the whole-machine simulation checks the cards against."
		(exclude_from_sim no)
		(at 25.4 45.72 0)
		(effects
			(font
				(size 1.6 1.6)
			)
			(justify left bottom)
		)
		(uuid "525b653f-2f28-4fd1-98ba-d81dd90f3ee3")
	)
	(text "TWO-PHASE CLOCK and RSTN (as on the register and sequencer boards)"
		(exclude_from_sim no)
		(at 25.4 165.1 0)
		(effects
			(font
				(size 2 2)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "995f4fab-834c-41d8-a14e-f76830d3506a")
	)
