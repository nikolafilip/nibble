	(text "NIBBLE CARD CTR6 - COUNTER BIT 6: program counter bit 6 and return register bit 6"
		(exclude_from_sim no)
		(at 25.4 15.24 0)
		(effects
			(font
				(size 3.5 3.5)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "b7b0230b-7eca-497d-8f1c-49eff69bfee4")
	)
	(text "Cell: 2N7000 + 47k pull-up (NMOS, see docs/gate-cell.md).  62 transistors, 34 resistors, 2 LEDs, 100 x 100 mm (docs/cards.md).\nFrom the bus header: PCE (count), PCL (load the jump target), CLK, RST.   To the bus header: PC6.\nFrom the sequencer over the LINK ribbon (2x6, chained along the eight counter cards): OPR6 (the jump target bit), PCR (load the return address), RAI (save the return address).\nCount carry TC6 in from bit 5 over the IN link; TC7 = TC6 and PC6 out to bit 7 over the OUT link.\nPC6: a master-slave flip-flop whose input is PC xor carry (count, or hold when PCE is low), OPR6 (PCL) or RA6 (PCR).  RA6: a transparent latch open while RAI and PH1.  RST clears both.\ndocs/isa.md is the specification; sim/emu.py the reference the whole-machine simulation checks the cards against."
		(exclude_from_sim no)
		(at 25.4 45.72 0)
		(effects
			(font
				(size 1.6 1.6)
			)
			(justify left bottom)
		)
		(uuid "e37832bc-afe5-46df-bc53-6fb07413f79b")
	)
	(text "TWO-PHASE CLOCK and RSTN (as on the register and sequencer boards)"
		(exclude_from_sim no)
		(at 25.4 165.1 0)
		(effects
			(font
				(size 2 2)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "1973c683-f4fd-4a7b-b1ed-769555c8a2f3")
	)
