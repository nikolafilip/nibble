	(text "NIBBLE CARD PANEL C - FRONT PANEL, OPERATOR: PC and M LEDs, the DATA switches and input port"
		(exclude_from_sim no)
		(at 25.4 15.24 0)
		(effects
			(font
				(size 3.5 3.5)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "ce3eeb33-6656-4ca2-8e84-89dc4b7cb07b")
	)
	(text "Cell: 2N7000 + 47k pull-up (NMOS, see docs/gate-cell.md).  32 transistors, 36 resistors, 16 LEDs, 100 x 100 mm (docs/cards.md).\nThe DATA switches are the input port: a closed switch is a 1, and while INP=1 the four bits are driven onto the bus (open drain) for the IN instruction.\nPC and SW lines have 1Meg pull-downs; M is pulled down on the hub."
		(exclude_from_sim no)
		(at 25.4 40.64 0)
		(effects
			(font
				(size 1.6 1.6)
			)
			(justify left bottom)
		)
		(uuid "7b756159-3e00-4311-b797-59d243d94fa8")
	)
	(text "INDICATORS: one LED per bus line.  A MOSFET gate draws no current, so the LEDs load nothing."
		(exclude_from_sim no)
		(at 25.4 149.86 0)
		(effects
			(font
				(size 2 2)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "d2832723-53e5-4a0a-9a14-e06c9ffaed62")
	)
