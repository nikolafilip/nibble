	(text "NIBBLE GATE COUPON: the 2N7000 + 47k cell, measured before any board is trusted"
		(exclude_from_sim no)
		(at 25.4 15.24 0)
		(effects
			(font
				(size 3.5 3.5)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "c1bddb34-1503-4845-bfe2-e6fc5bcad73b")
	)
	(text "26 transistors.  Power on J1 (5 V).  Drive IN, N1, N2, N3 from J2 (each has a 1M pull-down, so open = 0).\nMeasure at the test points: TP_RING period (gate delay = period / 10), TP_FO1 vs TP_FO10 rise time (fan-out 1 vs 10), TP_NAND / TP_NOR output low\nwith all three inputs high, TP_BUS with the hub-style 10k pull-up, supply current with everything low.  Fill the numbers into docs/gate-cell.md."
		(exclude_from_sim no)
		(at 25.4 35.56 0)
		(effects
			(font
				(size 1.6 1.6)
			)
			(justify left bottom)
		)
		(uuid "a9071dea-a695-4019-b6b0-cc819ed74d9c")
	)
