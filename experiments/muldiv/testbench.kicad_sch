	(text "TEST BENCH  -  drives the keypads (Y1..Y7 = operand A key, X1..X7 = operand B key), the op-code, START and CLOCK.  Run the simulator on this project and plot OUT_SIGN, OUT_B5..OUT_B0, DIV0."
		(exclude_from_sim no)
		(at 25.4 17.78 0)
		(effects
			(font
				(size 3 3)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "9a53ee28-6512-48b8-8485-8ba0c0dd8748")
	)
	(text "Sequence (time window -> operation -> expected memory contents):\n 0.40 ..  0.70 ms   ADD 3,4   ->   7  (OUT_SIGN, OUT_B5..0)\n 0.70 ..  1.00 ms   ADD 7,7   ->   14  (OUT_SIGN, OUT_B5..0)\n 1.00 ..  1.30 ms   SUB 7,5   ->   2  (OUT_SIGN, OUT_B5..0)\n 1.30 ..  1.60 ms   SUB 2,5   ->   -3  (OUT_SIGN, OUT_B5..0)\n 1.60 ..  1.90 ms   ADD 0,6   ->   6  (OUT_SIGN, OUT_B5..0)\n 1.90 ..  2.60 ms   MUL 3,5   ->   15  (OUT_SIGN, OUT_B5..0)\n 2.60 ..  3.30 ms   MUL 7,7   ->   49  (OUT_SIGN, OUT_B5..0)\n 3.30 ..  4.00 ms   MUL 6,0   ->   0  (OUT_SIGN, OUT_B5..0)\n 4.00 ..  4.70 ms   MUL 1,7   ->   7  (OUT_SIGN, OUT_B5..0)\n 4.70 ..  5.40 ms   DIV 7,2   ->   quotient 3 (OUT_B2..0), remainder 1 (OUT_B5..3)\n 5.40 ..  6.10 ms   DIV 6,3   ->   quotient 2 (OUT_B2..0), remainder 0 (OUT_B5..3)\n 6.10 ..  6.80 ms   DIV 5,7   ->   quotient 0 (OUT_B2..0), remainder 5 (OUT_B5..3)\n 6.80 ..  7.50 ms   DIV 7,1   ->   quotient 7 (OUT_B2..0), remainder 0 (OUT_B5..3)\n 7.50 ..  8.20 ms   DIV 4,0   ->   DIV0 flag = 1\n 8.20 ..  8.50 ms   SUB 6,6   ->   0  (OUT_SIGN, OUT_B5..0)\n 8.50 ..  9.20 ms   MUL 5,5   ->   25  (OUT_SIGN, OUT_B5..0)\n"
		(exclude_from_sim no)
		(at 25.4 120 0)
