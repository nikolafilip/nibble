(version 1)
(rule "jlc track" (constraint track_width (min 0.127mm)))
(rule "jlc clearance" (constraint clearance (min 0.127mm)))
(rule "jlc via" (constraint via_diameter (min 0.5mm)))
(rule "jlc hole" (constraint hole_size (min 0.3mm)))
(rule "jlc annular" (constraint annular_width (min 0.13mm)))
(rule "jlc hole to hole" (constraint hole_to_hole (min 0.5mm)))
(rule "jlc edge" (constraint edge_clearance (min 0.3mm)))
